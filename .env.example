# Known target geometry
# IMPORTANT: this project treats 32 inches as the OUTER CIRCLE RADIUS.
# If 32 inches is actually the full diameter, set this to 16.
NEXT_PUBLIC_TARGET_OUTER_RADIUS_INCHES=32
NEXT_PUBLIC_NORMALIZED_TARGET_SIZE=1024
NEXT_PUBLIC_AUTO_CALIBRATION_MIN_CONFIDENCE=0.55

# Network camera / MediaMTX HLS server
NEXT_PUBLIC_STREAM_BASE_URL=http://localhost:8888
NEXT_PUBLIC_STREAM_CAMERA_COUNT=12

# External ML inference API
# The web app sends a normalized square target crop to this endpoint.
NEXT_PUBLIC_ML_API_URL=http://localhost:8000/detect
NEXT_PUBLIC_ML_CONFIDENCE_THRESHOLD=0.50

# Firebase / Firestore central database
# Create a Firebase Web App, enable Firestore, and enable Anonymous Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=remote-firing-analyzer
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
